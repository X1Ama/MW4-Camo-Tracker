<UserControl x:Class="MasteryTracker.AdminPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Top" Text="PEOPLE" FontFamily="{StaticResource Display}"
                           FontSize="18" Foreground="{StaticResource Muted}" Margin="16,16,16,8"/>
                <Button DockPanel.Dock="Top" Style="{StaticResource Chip}" Content="+ NEW USER" Margin="12,0,12,10" Padding="12,8" FontSize="14" Click="NewUser_Click"/>
                <TextBox x:Name="UserSearch" DockPanel.Dock="Top" Margin="12,0,12,10" TextChanged="UserSearch_TextChanged"/>
                <ListBox x:Name="UserList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="UserList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" BorderThickness="1" Padding="7,2" Margin="8,0,0,0" CornerRadius="4"
                                        VerticalAlignment="Center" Background="{StaticResource Panel2}"
                                        BorderBrush="{StaticResource Muted}">
                                    <TextBlock Text="{Binding RoleLabel}" FontFamily="Consolas" FontSize="13"
                                               FontWeight="SemiBold" Foreground="{StaticResource Fg}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="owner">
                                                        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="admin">
                                                        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,28">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="BACK TO TRACKER"
                            FontSize="13" Padding="12,7" VerticalAlignment="Center" Click="Back_Click"/>
                    <TextBlock Text="ADMIN PANEL" FontFamily="{StaticResource Display}" FontSize="30"/>
                </DockPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource Muted}"/>

                <StackPanel x:Name="CreatePanel">
                <TextBlock Text="CREATE USER" FontFamily="{StaticResource Display}" FontSize="18"
                           Foreground="{StaticResource Muted}" Margin="0,22,0,8"/>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="USER NAME" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="NewUser" MaxLength="32"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="PASSWORD (6+ CHARACTERS)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="NewPass"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="DISPLAY NAME (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="NewName"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="ROLE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="NewRole" Padding="8,6"/>
                        </StackPanel>
                        <Button x:Name="CreateButton" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Chip}"
                                Content="CREATE USER" HorizontalAlignment="Left" Padding="18,9"
                                Background="{StaticResource Accent}" Foreground="{StaticResource AccentFg}"
                                BorderBrush="{StaticResource Accent}" Click="Create_Click"/>
                    </Grid>
                </Border>

                </StackPanel>

                <!-- selected user -->
                <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                    <TextBlock x:Name="DetailTitle" FontFamily="{StaticResource Display}" FontSize="22" Margin="0,28,0,2"/>
                    <TextBlock x:Name="DetailSub" Foreground="{StaticResource Fg}" FontFamily="Consolas" FontSize="14"/>

                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            Padding="16" Margin="0,12,0,0" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="DISPLAY NAME" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="SAVE" Margin="8,0,0,0"
                                        Click="SaveName_Click"/>
                                <TextBox x:Name="DetailName"/>
                            </DockPanel>

                            <TextBlock Text="NEW PASSWORD" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="SET PASSWORD" Margin="8,0,0,0"
                                        Click="SetPassword_Click"/>
                                <Button DockPanel.Dock="Right" x:Name="ShowPassButton" Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="12,8"
                                        Click="ShowPass_Click" ToolTip="Show or hide the password">
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path Stroke="{StaticResource Fg}" StrokeThickness="2" StrokeLineJoin="Round"
                                                  Data="M1,12 C3,7 7.5,5 12,5 C16.5,5 21,7 23,12 C21,17 16.5,19 12,19 C7.5,19 3,17 1,12 Z M9,12 A3,3 0 1 0 15,12 A3,3 0 1 0 9,12 Z"/>
                                            <Path x:Name="EyeSlash" Visibility="Collapsed" Stroke="{StaticResource Fg}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,20 L20,4"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Grid>
                                    <PasswordBox x:Name="DetailPassHidden" PasswordChanged="DetailPassHidden_Changed"/>
                                    <TextBox x:Name="DetailPass" Visibility="Collapsed" TextChanged="DetailPass_Changed"/>
                                </Grid>
                            </DockPanel>

                            <StackPanel x:Name="RoleRow">
                                <TextBlock Text="ROLE" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="SET ROLE" Margin="8,0,0,0"
                                            Click="SetRole_Click"/>
                                    <ComboBox x:Name="DetailRole" Padding="8,6"/>
                                </DockPanel>
                            </StackPanel>

                            <Button x:Name="DeleteButton" Style="{StaticResource Chip}" Content="DELETE USER"
                                    HorizontalAlignment="Left" Foreground="{StaticResource Warn}" Click="Delete_Click"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="AssignPanel" Visibility="Collapsed">
                        <TextBlock Text="CLIENTS THIS GRINDER MANAGES" FontFamily="{StaticResource Display}" FontSize="18"
                                   Foreground="{StaticResource Muted}" Margin="0,22,0,8"/>
                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" CornerRadius="8">
                            <WrapPanel x:Name="AssignList"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
