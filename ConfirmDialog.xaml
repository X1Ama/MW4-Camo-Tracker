<UserControl x:Class="MasteryTracker.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" PreviewKeyDown="Dialog_PreviewKeyDown">
    <Grid Background="#E60D0F10">
        <Border Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="12" Padding="28">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="23" Background="#2A2209"
                            BorderBrush="{StaticResource Warn}" BorderThickness="1.5" VerticalAlignment="Top">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Rectangle Width="4" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource Warn}"/>
                            <Ellipse Width="4" Height="4" Margin="0,4,0,0" Fill="{StaticResource Warn}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,0,0,0" Width="320">
                        <TextBlock x:Name="TitleText" FontFamily="{StaticResource Display}" FontSize="26"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="BodyText" Foreground="{StaticResource Muted}" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="21"/>
                    </StackPanel>
                </StackPanel>

                <DockPanel Margin="0,26,0,0">
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource Chip}"
                            Content="CANCEL" Margin="10,0,0,0" Padding="20,10" Click="Cancel_Click"/>
                    <Button x:Name="ConfirmButton" Style="{StaticResource Chip}" Padding="20,10"
                            Background="{StaticResource Warn}" Foreground="{StaticResource AccentFg}"
                            BorderBrush="{StaticResource Warn}" Click="Confirm_Click"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
