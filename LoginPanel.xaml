<UserControl x:Class="MasteryTracker.LoginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Bg}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
        <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
<StackPanel Margin="36,32">
        <Viewbox x:Name="LogoMark" Width="56" Height="56" HorizontalAlignment="Left" Margin="0,0,0,14">
            <Canvas Width="256" Height="256">
                <Rectangle Width="256" Height="256" RadiusX="56" RadiusY="56" Fill="#FFD21A"/>
                <Path Fill="#0D0F10" Data="M40,184 L40,72 L82,72 L128,130 L174,72 L216,72 L216,184 L182,184 L182,124 L138,178 L118,178 L74,124 L74,184 Z"/>
                <Path Fill="#FFD21A" Data="M134,58 L160,58 L114,204 L88,204 Z"/>
                <Path Fill="#FFFFFF" Data="M150,214 C176,184 200,146 230,96 C220,142 196,184 168,224 Z"/>
            </Canvas>
        </Viewbox>
        <TextBlock Text="MW4 CAMO TRACKER" FontFamily="{StaticResource Display}" FontSize="30"
                   TextWrapping="Wrap" Margin="0,2,0,24"/>

        <TextBlock Text="USER" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,0,16">

            <Grid>
                <TextBox x:Name="EmailBox" BorderThickness="0" Background="Transparent" Padding="8,0,12,0" FontSize="15" VerticalContentAlignment="Center"
                         TextChanged="User_Changed"/>
                <TextBlock x:Name="UserHint" Text="Enter your user name" Foreground="{StaticResource Muted}"
                           Margin="12,0,0,0" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <TextBlock Text="PASSWORD" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <Border Style="{StaticResource FieldBox}" Margin="0,0,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" BorderThickness="0" Background="Transparent"
                             Padding="8,0,12,0" FontSize="15" VerticalContentAlignment="Center" VerticalAlignment="Stretch"
                             KeyDown="PasswordBox_KeyDown" PasswordChanged="Pw_Changed"/>
                <TextBox x:Name="PlainBox" BorderThickness="0" Background="Transparent"
                         Padding="8,0,12,0" FontSize="15" VerticalContentAlignment="Center" VerticalAlignment="Stretch"
                         Visibility="Collapsed" KeyDown="PasswordBox_KeyDown" TextChanged="Pw_Changed"/>
                <TextBlock x:Name="PwHint" Text="Enter your password" Foreground="{StaticResource Muted}"
                           Margin="12,0,0,0" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Border Grid.Column="1" Margin="0,0,6,0">
                    <Button x:Name="ShowButton" Width="36" Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="Show password" Click="ShowButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Hover" Background="Transparent" CornerRadius="7">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Background" Value="{StaticResource Panel2}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M1,12 C4,6 8,4 12,4 C16,4 20,6 23,12 C20,18 16,20 12,20 C8,20 4,18 1,12 Z"
                                      Stroke="{StaticResource Fg}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                                         Stroke="{StaticResource Fg}" StrokeThickness="2"/>
                                <Line x:Name="EyeSlash" X1="3" Y1="21" X2="21" Y2="3" Visibility="Collapsed"
                                      Stroke="{StaticResource Fg}" StrokeThickness="2.4" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Border>
            </Grid>
        </Border>
        <CheckBox x:Name="RememberCheck" Style="{StaticResource RememberBox}" Content="Remember me"
                          Margin="2,0,0,20" Focusable="True"/>
                <Button x:Name="SignInButton" Style="{StaticResource Chip}" Content="SIGN IN" FontSize="17"
                Background="{StaticResource Accent}" Foreground="{StaticResource AccentFg}"
                BorderBrush="{StaticResource Accent}" Padding="14,10" Click="SignIn_Click"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                   Margin="0,14,0,0" Visibility="Collapsed"/>

        <Expander x:Name="ServerExpander" Header="Server settings" Foreground="{StaticResource Muted}"
                  Margin="0,26,0,0">
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="SERVER URL" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="UrlBox" Margin="0,0,0,10"/>
                <TextBlock Text="PUBLIC KEY" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="KeyBox"/>
            </StackPanel>
        </Expander>
        <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,18,0,0"/>
    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>