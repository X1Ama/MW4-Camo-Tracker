<Window x:Class="MasteryTracker.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mastery Camo Tracker" Width="420" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Bg}">
    <StackPanel Margin="36,32">
        <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{StaticResource Panel2}"
                BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="12" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock x:Name="UpdateText" TextWrapping="Wrap"/>
                <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,8,0,0" Visibility="Collapsed"
                             Minimum="0" Maximum="1" Foreground="{StaticResource Accent}"
                             Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"/>
                <Button x:Name="UpdateButton" Style="{StaticResource Chip}" Content="UPDATE NOW"
                        HorizontalAlignment="Left" Margin="0,10,0,0" FontSize="14" Padding="14,7"
                        Background="{StaticResource Accent}" Foreground="{StaticResource AccentFg}"
                        BorderBrush="{StaticResource Accent}" Click="Update_Click"/>
            </StackPanel>
        </Border>
        <TextBlock Text="MW4" Foreground="{StaticResource Muted}" FontFamily="{StaticResource Display}"
                   FontSize="14"/>
        <TextBlock Text="MASTERY CAMO TRACKER" FontFamily="{StaticResource Display}" FontSize="30"
                   TextWrapping="Wrap" Margin="0,2,0,24"/>

        <TextBlock Text="USER" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}"
                Margin="0,0,0,14" Height="38">
            <Grid>
                <TextBox x:Name="EmailBox" BorderThickness="0" Background="Transparent" Padding="12,0" VerticalContentAlignment="Center"
                         TextChanged="User_Changed"/>
                <TextBlock x:Name="UserHint" Text="Enter your user name" Foreground="{StaticResource Muted}"
                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
        </Border>
        <TextBlock Text="PASSWORD" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
        <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Panel}"
                Margin="0,0,0,18" Height="38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" BorderThickness="0" Background="Transparent"
                             Padding="12,0" VerticalContentAlignment="Center" VerticalAlignment="Stretch"
                             KeyDown="PasswordBox_KeyDown" PasswordChanged="Pw_Changed"/>
                <TextBox x:Name="PlainBox" BorderThickness="0" Background="Transparent"
                         Padding="12,0" VerticalContentAlignment="Center" VerticalAlignment="Stretch"
                         Visibility="Collapsed" KeyDown="PasswordBox_KeyDown" TextChanged="Pw_Changed"/>
                <TextBlock x:Name="PwHint" Text="Enter your password" Foreground="{StaticResource Muted}"
                           Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <Button x:Name="ShowButton" Width="40" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="Show password" Click="ShowButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Hover" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Background" Value="{StaticResource Panel2}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M1,12 C4,6 8,4 12,4 C16,4 20,6 23,12 C20,18 16,20 12,20 C8,20 4,18 1,12 Z"
                                      Stroke="{StaticResource Fg}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8"
                                         Stroke="{StaticResource Fg}" StrokeThickness="2"/>
                                <Line x:Name="EyeSlash" X1="3" Y1="21" X2="21" Y2="3" Visibility="Collapsed"
                                      Stroke="{StaticResource Fg}" StrokeThickness="2.4" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Border>
            </Grid>
        </Border>
        <Button x:Name="SignInButton" Style="{StaticResource Chip}" Content="SIGN IN" FontSize="17"
                Background="{StaticResource Accent}" Foreground="{StaticResource AccentFg}"
                BorderBrush="{StaticResource Accent}" Padding="14,10" Click="SignIn_Click"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                   Margin="0,14,0,0" Visibility="Collapsed"/>

        <Expander x:Name="ServerExpander" Header="Server settings" Foreground="{StaticResource Muted}"
                  Margin="0,26,0,0">
            <StackPanel Margin="0,10,0,0">
                <TextBlock Text="SERVER URL" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="UrlBox" Margin="0,0,0,10"/>
                <TextBlock Text="PUBLIC KEY" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="KeyBox"/>
            </StackPanel>
        </Expander>
        <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,18,0,0"/>
    </StackPanel>
</Window>
