<UserControl x:Class="MasteryTracker.PasswordPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#E60D0F10">
        <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Padding="26">
            <StackPanel>
                <TextBlock Text="CHANGE PASSWORD" FontFamily="{StaticResource Display}" FontSize="26"/>
                <TextBlock x:Name="WhoText" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"
                           Margin="0,2,0,18"/>

                <TextBlock Text="CURRENT PASSWORD" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <PasswordBox x:Name="CurrentBox" Margin="0,0,0,14" Padding="10,9" PasswordChanged="Changed"/>

                <TextBlock Text="NEW PASSWORD (6+ CHARACTERS)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <PasswordBox x:Name="NewBox" Margin="0,0,0,14" Padding="10,9" PasswordChanged="Changed"/>

                <TextBlock Text="REPEAT NEW PASSWORD" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4"/>
                <PasswordBox x:Name="RepeatBox" Margin="0,0,0,16" Padding="10,9" PasswordChanged="Changed"
                             KeyDown="RepeatBox_KeyDown"/>

                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14"
                           Visibility="Collapsed"/>

                <DockPanel>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="CLOSE"
                            Margin="8,0,0,0" Padding="16,9" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Style="{StaticResource Chip}" Content="CHANGE PASSWORD"
                            Padding="16,9" Background="{StaticResource Accent}" Foreground="{StaticResource AccentFg}"
                            BorderBrush="{StaticResource Accent}" Click="Save_Click"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
