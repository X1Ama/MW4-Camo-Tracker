<UserControl x:Class="MasteryTracker.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}" Focusable="True" PreviewKeyDown="Panel_PreviewKeyDown">
    <Grid>
        <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="12" Padding="30">
            <StackPanel>
                <TextBlock Text="SETTINGS" FontFamily="{StaticResource Display}" FontSize="28"/>
                <TextBlock x:Name="WhoText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,22"/>

                <TextBlock Text="WINDOW" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/>
                <CheckBox x:Name="StartupCheck" Style="{StaticResource RememberBox}" Content="Launch when Windows starts"
                          Checked="Startup_Changed" Unchecked="Startup_Changed" Margin="0,0,0,2"/>
                <TextBlock Text="Opens the tracker by itself every time you sign in to Windows." Foreground="{StaticResource Muted}"
                           FontSize="12" Margin="30,0,0,16" TextWrapping="Wrap"/>
                <CheckBox x:Name="MinimizedCheck" Style="{StaticResource RememberBox}" Content="Start minimized"
                          Checked="Minimized_Changed" Unchecked="Minimized_Changed" Margin="0,0,0,2"/>
                <TextBlock Text="The app opens in the taskbar instead of in front of you." Foreground="{StaticResource Muted}"
                           FontSize="12" Margin="30,0,0,24" TextWrapping="Wrap"/>

                <TextBlock Text="ACCOUNT" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,10"/>
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource Chip}" Content="CHANGE PASSWORD" Padding="12,9" FontSize="14"
                            Margin="0,0,5,0" Click="ChangePassword_Click"/>
                    <Button Style="{StaticResource Chip}" Content="SIGN OUT" Padding="12,9" FontSize="14"
                            Margin="5,0,0,0" Click="SignOut_Click"/>
                </UniformGrid>

                <Button Style="{StaticResource Chip}" Content="DONE" Padding="12,10" FontSize="14" Margin="0,26,0,0"
                        Background="{StaticResource Accent}" Foreground="{StaticResource AccentFg}"
                        BorderBrush="{StaticResource Accent}" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
