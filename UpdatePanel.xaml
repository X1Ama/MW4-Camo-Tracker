<UserControl x:Class="MasteryTracker.UpdatePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#E60D0F10">
        <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Padding="26">
            <StackPanel>
                <TextBlock Text="UPDATE AVAILABLE" FontFamily="{StaticResource Display}" FontSize="26"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="12"
                           Margin="0,2,0,18"/>

                <TextBlock Text="WHAT'S NEW" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="8" Padding="14,12" MaxHeight="260">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NotesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="6" Height="6" CornerRadius="1" Margin="0,7,10,0"
                                                VerticalAlignment="Top" Background="{StaticResource Accent}">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="45" CenterX="3" CenterY="3"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="14"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="NoNotesText" Text="No notes were provided for this version."
                           Foreground="{StaticResource Muted}" FontSize="13" Visibility="Collapsed"/>

                <ProgressBar x:Name="Progress" Height="6" Margin="0,16,0,0" Minimum="0" Maximum="1"
                             Visibility="Collapsed" Foreground="{StaticResource Accent}"
                             Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}"/>
                <TextBlock x:Name="MessageText" Foreground="{StaticResource Warn}" FontSize="13"
                           TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                <DockPanel Margin="0,18,0,0">
                    <Button x:Name="LaterButton" DockPanel.Dock="Right" Style="{StaticResource Chip}" Content="LATER"
                            Margin="8,0,0,0" Padding="16,9" Click="Later_Click"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource Chip}" Content="UPDATE NOW" Padding="16,9"
                            Background="{StaticResource Accent}" Foreground="{StaticResource AccentFg}"
                            BorderBrush="{StaticResource Accent}" Click="Update_Click"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
