<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MasteryTracker.MainWindow"
        Title="MW4 Camo Tracker" Width="1200" Height="800" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="avares://MasteryCamoTracker/Assets/app.png">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Client list, staff only -->
        <Border x:Name="SidePanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CLIENTS" Classes="display" FontSize="22"
                           Foreground="{StaticResource Muted}" Margin="16,16,16,8"/>
                <TextBox x:Name="ClientSearch" DockPanel.Dock="Top" Margin="12,0,12,10"/>
                <ListBox x:Name="ClientList" Background="Transparent" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,18,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock x:Name="UserText" Foreground="{StaticResource Muted}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="UpdateButton" Classes="chip primary" Content="UPDATE AVAILABLE" FontSize="17" Padding="10,5"
                            Margin="0,0,8,0" IsVisible="False"/>
                    <Button x:Name="AdminButton" Classes="chip" Content="ADMIN PANEL" FontSize="17" Padding="10,5"
                            Margin="0,0,8,0" IsVisible="False"/>
                    <Button x:Name="SettingsButton" Classes="chip" Padding="7" Width="34" Height="34"
                            HorizontalContentAlignment="Center" AutomationProperties.Name="SETTINGS">
                        <ToolTip.Tip>Settings</ToolTip.Tip>
                        <Viewbox Width="18" Height="18">
                            <Path Width="24" Height="24" Fill="{StaticResource Fg}"
                                  Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 H10.08 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.69 4.8,12 C4.8,12.31 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.65,21.43 9.84,21.6 10.08,21.6 H13.92 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="KickerText" Text="MW4" Foreground="{StaticResource Muted}" Classes="display" FontSize="16"/>
                    <TextBlock x:Name="TitleText" Classes="display" FontSize="38" Text="MW4 CAMO TRACKER"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="12" Classes="mono"/>
                </StackPanel>
            </DockPanel>

            <StackPanel x:Name="Tabs" Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0"/>

            <DockPanel Grid.Row="2" Margin="0,12,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchBox" Width="190"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <ProgressBar x:Name="Progress" Width="260" Height="8" Minimum="0" Maximum="100"
                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="ProgressText" Classes="mono" FontSize="13" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TrackerPanel" Margin="0,0,12,24"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
