<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MasteryTracker.PasswordPanel">
    <Grid Background="#E60D0F10">
        <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="10" Padding="26">
            <StackPanel>
                <TextBlock Text="CHANGE PASSWORD" Classes="display" FontSize="32"/>
                <TextBlock x:Name="WhoText" Foreground="{StaticResource Muted}" Classes="mono" FontSize="12" Margin="0,2,0,18"/>

                <TextBlock Text="CURRENT PASSWORD" Classes="label"/>
                <TextBox x:Name="CurrentBox" PasswordChar="&#x25CF;" Margin="0,0,0,14" Padding="10,9"/>

                <TextBlock Text="NEW PASSWORD (6+ CHARACTERS)" Classes="label"/>
                <TextBox x:Name="NewBox" PasswordChar="&#x25CF;" Margin="0,0,0,14" Padding="10,9"/>

                <TextBlock Text="REPEAT NEW PASSWORD" Classes="label"/>
                <TextBox x:Name="RepeatBox" PasswordChar="&#x25CF;" Margin="0,0,0,16" Padding="10,9"/>

                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14" IsVisible="False"/>

                <DockPanel>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Classes="chip" Content="CLOSE"
                            Margin="8,0,0,0" Padding="16,9"/>
                    <Button x:Name="SaveButton" Classes="chip primary" Content="CHANGE PASSWORD" Padding="16,9"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
