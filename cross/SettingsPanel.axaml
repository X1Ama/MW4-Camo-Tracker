<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MasteryTracker.SettingsPanel" Focusable="True">
    <Grid Background="{StaticResource Bg}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24"
                    Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="30">
                <StackPanel>
                    <TextBlock Text="SETTINGS" Classes="display" FontSize="36"/>
                    <TextBlock x:Name="WhoText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,2,0,22"/>

                    <TextBlock Text="WINDOW" Classes="label" Margin="0,0,0,10"/>
                    <CheckBox x:Name="StartupCheck" Classes="remember" Margin="0,0,0,2"/>
                    <TextBlock x:Name="StartupNote" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="30,0,0,16" TextWrapping="Wrap"/>
                    <CheckBox x:Name="MinimizedCheck" Classes="remember" Margin="0,0,0,2"/>
                    <TextBlock x:Name="MinimizedNote" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="30,0,0,16" TextWrapping="Wrap"/>

                    <CheckBox x:Name="TrayCheck" Classes="remember" Margin="0,0,0,2"/>
                    <TextBlock x:Name="TrayNote" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="30,0,0,16" TextWrapping="Wrap"/>

                    <StackPanel x:Name="NotifyRow" IsVisible="False">
                        <CheckBox x:Name="NotifyCheck" Classes="remember" Content="Tell me when a client comes online" Margin="0,0,0,2"/>
                        <TextBlock Text="A small banner appears in the tracker when somebody opens the app." Foreground="{StaticResource Muted}"
                                   FontSize="12" Margin="30,0,0,16" TextWrapping="Wrap"/>
                        <CheckBox x:Name="SoundCheck" Classes="remember" Content="Play a sound with it" Margin="0,0,0,2"/>
                        <TextBlock Text="A short chime, even when the tracker is behind other windows."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="30,0,0,24" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="ACCOUNT" Classes="label" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <Button x:Name="PasswordButton" Classes="chip" Content="CHANGE PASSWORD" Padding="12,9" FontSize="16" Margin="0,0,5,0"/>
                        <Button x:Name="SignOutButton" Classes="chip" Content="SIGN OUT" Padding="12,9" FontSize="16" Margin="5,0,0,0"/>
                    </UniformGrid>

                    <Button x:Name="DoneButton" Classes="chip primary center" Content="DONE" Padding="12,10" FontSize="16" Margin="0,26,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
